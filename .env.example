# docker compose 변수. `cp .env.example .env` 후 작성 (.env는 git 제외)
# 컨테이너 환경변수(DB 접속 정보 등)는 sentinel.env, 이 파일은 HTTPS 앞단(sentinel-proxy) 설정만

# 접속 주소. 다른 PC에서 쓰려면 그 PC들이 이 이름으로 이 서버를 찾을 수 있어야 함 (사내 DNS 또는 hosts)
# 쉼표로 여러 개 지정 가능. 주소마다 인증서 발급. IP는 DHCP로 바뀌면 인증서와 어긋나므로 이름을 우선
# 예: SENTINEL_SITE_ADDRESS=localhost, sentinel.team.internal
SENTINEL_SITE_ADDRESS=localhost

# 인증서 방식
#   internal                         Caddy 내부 인증 기관. 사내 주소용. 루트 인증서를 PC마다 신뢰 등록 (README 참고)
#   admin@example.com                Let's Encrypt 자동 발급. 공개 도메인이고 80·443 포트가 인터넷에서 접근 가능할 때
#   /certs/cert.pem /certs/key.pem   보유한 인증서. proxy/certs/에 cert.pem·key.pem 배치
SENTINEL_TLS=internal
