# HTTPS 앞단. TLS를 종료하고 sentinel-web으로 전달 (Spring API는 web의 BFF 프록시를 거쳐서만 접근)
# 예외: CI 등이 API 토큰(Bearer snt_…)으로 부르는 실행 시작·결과 조회만 Spring으로 직접 전달 (토큰 권한은 Spring이 다시 확인)
#
# SENTINEL_SITE_ADDRESS  접속 주소. 예: sentinel.example.com, localhost
# SENTINEL_UPSTREAM      전달 대상 (기본 sentinel-web:3000, E2E 스택은 e2e-web:3000)
# SENTINEL_API_UPSTREAM  API 토큰 요청 전달 대상 (기본 sentinel-api:8080, E2E 스택은 e2e-api:8080)
# SENTINEL_HSTS_MAX_AGE  HSTS 유지 시간(초). 0이면 미사용(기본). 팀원 PC가 이미 신뢰하는 인증서(회사·Let's Encrypt)일 때만 사용
# SENTINEL_TLS           인증서 방식
#   internal                           Caddy 내부 인증 기관 (사내 주소용, 기본값). 루트 인증서를 PC마다 신뢰 등록
#   admin@example.com                  Let's Encrypt 자동 발급 (공개 도메인, 80·443 포트가 인터넷에서 접근 가능해야 함)
#   /certs/cert.pem /certs/key.pem     보유한 인증서 (proxy/certs에 두면 컨테이너의 /certs로 연결)
{
	# 관리 API는 사용하지 않음. 설정 변경은 컨테이너 재시작으로 반영
	admin off
}

{$SENTINEL_SITE_ADDRESS} {
	tls {$SENTINEL_TLS}

	encode zstd gzip

	header {
		# 응답 형식 추측 금지, 다른 사이트에 주소 경로 미전달, 다른 사이트의 프레임 삽입 금지
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		-Server
	}

	# HSTS: 브라우저가 이 주소를 기간 동안 HTTPS로만 열도록 기억 (첫 접속 이후 평문 HTTP 가로채기 차단)
	# localhost 제외: HSTS는 포트와 무관하게 호스트 전체에 적용되어 같은 PC의 http://localhost:3000 개발 서버까지 막힘
	# includeSubDomains 미사용: 회사 도메인의 다른 서비스까지 HTTPS 강제 방지
	@hsts not host localhost
	header @hsts Strict-Transport-Security "max-age={$SENTINEL_HSTS_MAX_AGE:0}"

	# API 토큰으로 부르는 실행 시작(POST /api/runs)·결과 조회(GET /api/runs/{id})만 Spring으로. web의 BFF는 쓰기를 열지 않고
	# 쿠키 세션만 쓰므로 CI가 거칠 수 없음. 브라우저는 다른 사이트에서 Authorization 헤더를 붙여 보낼 수 없어(CORS 사전 요청을
	# Spring이 허용하지 않음) 쿠키로 인증되는 쓰기 경로는 생기지 않음. 그 외 경로·메서드는 Spring의 AuthFilter가 403
	@api_token {
		header Authorization "Bearer snt_*"
		path /api/runs /api/runs/*
	}
	handle @api_token {
		reverse_proxy {$SENTINEL_API_UPSTREAM:sentinel-api:8080}
	}

	# Host 헤더를 그대로 전달하므로 Next.js Server Action의 출처 확인(Origin과 Host 비교)이 그대로 동작
	handle {
		reverse_proxy {$SENTINEL_UPSTREAM:sentinel-web:3000}
	}
}

# 컨테이너 안에서만 쓰는 상태 확인용 (포트 미공개)
:8081 {
	respond "ok"
}
