{
  "mappings": [
    {
      "priority": 1,
      "request": {
        "method": "POST",
        "urlPath": "/auth/login",
        "bodyPatterns": [{ "equalToJson": { "username": "demo", "password": "demo-password" } }]
      },
      "response": {
        "status": 200,
        "headers": { "Content-Type": "application/json" },
        "jsonBody": { "token": "demo-token-7f3a", "expiresIn": 3600 }
      }
    },
    {
      "priority": 5,
      "request": { "method": "POST", "urlPath": "/auth/login" },
      "response": {
        "status": 401,
        "headers": { "Content-Type": "application/json" },
        "jsonBody": { "error": "invalid credentials" }
      }
    }
  ]
}
