# sentinel-api 컨테이너 환경변수. `cp sentinel.env.example sentinel.env` 후 작성 (sentinel.env는 git 제외)
# 값에 따옴표 사용 금지. docker --env-file은 따옴표까지 값으로 인식

# 로컬 PostgreSQL: 컨테이너 안의 localhost는 컨테이너 자신이므로 host.docker.internal 사용
DB_URL=jdbc:postgresql://host.docker.internal:5432/sentinel?currentSchema=sentinel
# RDS: DB_URL=jdbc:postgresql://<rds-endpoint>:5432/<db>?currentSchema=sentinel
DB_USERNAME=postgres
DB_PASSWORD=

# 실패 알림 수신 Webhook 주소 (선택). 미지정 시 알림은 로그로만 기록
# Slack·Teams 수신 Webhook 주소를 그대로 사용 가능. 주소 자체가 자격증명이므로 공유 금지
# SENTINEL_WEBHOOK_URL=https://hooks.example.com/services/...

# 결과 화면 주소 (선택). 지정 시 실패 알림에 실행 결과 링크 추가
# SENTINEL_WEB_URL=http://localhost:3000
