# sentinel-api 컨테이너 환경변수. `cp sentinel.env.example sentinel.env` 후 작성 (sentinel.env는 git 제외)
# 값에 따옴표 사용 금지. docker --env-file은 따옴표까지 값으로 인식

# 로컬 PostgreSQL: 컨테이너 안의 localhost는 컨테이너 자신이므로 host.docker.internal 사용
DB_URL=jdbc:postgresql://host.docker.internal:5432/sentinel?currentSchema=sentinel
# RDS: DB_URL=jdbc:postgresql://<rds-endpoint>:5432/<db>?currentSchema=sentinel&sslmode=require
#   sslmode=require: 비밀번호·데이터를 암호화하여 전송 (PostgreSQL JDBC 기본값 prefer는 서버가 거부하면 평문으로 전환)
DB_USERNAME=postgres
DB_PASSWORD=

# 기본 알림 채널 Webhook 주소 (선택, 운영에서는 권장). 미지정 시 이 채널 알림은 로그로만 기록
# 프로젝트 Webhook이 없는 프로젝트의 실패·복구 알림, DB 연결 실패·복구, 모니터링 공백, 주간 요약을 이 채널로 보냄
# Slack(hooks.slack.com)·Teams(워크플로·커넥터) 주소면 채널 서식으로, 그 외는 텍스트로 보냄. 주소 자체가 자격증명이므로 공유 금지
# SENTINEL_WEBHOOK_URL=https://hooks.example.com/services/...

# 외부 생존 신호 주소 (선택). 스케줄 폴링마다 GET으로 보내고, 끊기면 외부 감시 서비스가 알림
# healthchecks.io·Uptime Kuma(푸시)·Better Stack(하트비트) 등의 신호 주소. 주소 자체가 자격증명이므로 공유 금지
# SENTINEL_HEARTBEAT_URL=https://hc-ping.com/...

# 결과 화면 주소 (선택). 지정 시 실패 알림에 실행 결과 링크 추가
# SENTINEL_WEB_URL=https://localhost

# 최초 관리자 계정. 사용자가 없을 때 1회 생성되며 첫 로그인 후 비밀번호 변경 권장
# SENTINEL_ADMIN_EMAIL=admin@example.com
# SENTINEL_ADMIN_PASSWORD=

# 환경 시크릿(토큰·API 키)과 프로젝트별 알림 Webhook 주소의 암호화 키 (선택, 운영에서는 권장). 미지정 시 둘 다 등록 거부
# 생성: openssl rand -base64 32
# 분실 시 저장된 시크릿·프로젝트 Webhook을 복호화할 수 없어 다시 입력해야 함
# SENTINEL_SECRET_KEY=

# 암호화 키 교체 시에만 지정 (선택). 교체 전 키. 기동 시 저장된 값을 새 키(SENTINEL_SECRET_KEY)로 다시 암호화
# 기동 로그의 "Re-encrypted" 확인 후 줄 삭제. 절차는 docs/deploy.md "암호화 키 교체"
# SENTINEL_SECRET_KEY_PREVIOUS=
